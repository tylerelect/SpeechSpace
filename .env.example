# Copy to .env (gitignored) and fill in locally. Placeholders only; never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=speechspace_dev
APP_DEV_TOKEN=<shared-dev-token>
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: an OpenAI-compatible model server instead of Gemini (used when both
# LLM_BASE_URL and LLM_MODEL are set). Examples:
#   vLLM on a Brev GPU:   LLM_BASE_URL=http://<brev-host>:8000/v1  LLM_MODEL=<served model id>
#   build.nvidia.com:     LLM_BASE_URL=https://integrate.api.nvidia.com/v1  LLM_API_KEY=nvapi-...
# Reasoning is off unless LLM_THINKING=1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=

# Speech-to-text. Generic adapter: POST multipart `file` to STT_ENDPOINT_URL,
# optional Bearer STT_API_TOKEN, response JSON `transcript` or `text`.
STT_ENDPOINT_URL=
STT_API_TOKEN=

# ElevenLabs adapter: set STT_PROVIDER=elevenlabs (or point STT_ENDPOINT_URL at
# api.elevenlabs.io). Both key and model id are required.
STT_PROVIDER=
ELEVENLABS_API_KEY=<elevenlabs-api-key>
ELEVENLABS_STT_MODEL=<elevenlabs-stt-model-id>
